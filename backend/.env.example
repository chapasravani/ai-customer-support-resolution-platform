# Copy this file to backend/.env and fill in your own values.
# This is separate from final_customer_support/.env - that file is
# untouched and keeps controlling the ADK agent's own settings.

# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
# Or a MongoDB Atlas connection string, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/

MONGODB_DB_NAME=customer_support

# Phase 2 - used to sign login tokens (JWTs).
# Generate a real one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

# Direct Google Gemini API Configuration (Google ADK)
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=your_gemini_api_key_here

# Allowed CORS origins (comma-separated). If unset, defaults to standard local dev ports.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ORIGINS=

