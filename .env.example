# Canonical configuration template for the AI Customer Support Platform
# Copy this file to .env (or backend/.env and final_customer_support/.env)

# Direct Google Gemini API Configuration (Google ADK)
GOOGLE_API_KEY=your_gemini_api_key_here
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.1-flash-lite

# Database Configuration
# Local MongoDB: mongodb://localhost:27017
# If unreachable, system automatically falls back to persistent local store (mongomock).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=customer_support

# Authentication (JWT)
# Minimum 32-character secret key. Startup will fail if left blank/placeholder.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8000,http://127.0.0.1:8000
