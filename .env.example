# Configuration template. Copy to `.env` in the repository root and fill in values.
# Real environment variables (shell, CI, server) always take precedence over .env.

# Model provider (Google ADK)
GOOGLE_API_KEY=your_gemini_api_key_here
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.1-flash-lite
# MAX_OUTPUT_TOKENS=1024

# Database. If MongoDB is unreachable the app falls back to the local
# single-process file store at data/runtime/db_store.json.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=customer_support

# Authentication (JWT). At least 32 characters; startup fails if blank or a placeholder.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

# CORS allowed origins (comma-separated). Empty = local dev defaults.
CORS_ORIGINS=

# Optional overrides
# LOGIN_RATE_LIMIT_ATTEMPTS=10
# LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
# SUPPORTAI_FIXTURE_DIR=data/fixtures
# SUPPORTAI_RUNTIME_DIR=data/runtime
# SUPPORTAI_DATA_FILE=data/runtime/db_store.json
# CHROMA_DIR=data/runtime/chroma_db
